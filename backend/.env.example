# ---------------------------------------------------------------------------
# Smart Classroom AI - backend configuration (copy to backend/.env)
# Every value can also be provided as an environment variable.
# ---------------------------------------------------------------------------

# development | production | test
SCAI_ENVIRONMENT=development
SCAI_HOST=0.0.0.0
SCAI_PORT=8000

# Signing key for JWTs and credential encryption.
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# If empty, a key is generated once and stored in data/.secret_key (0600).
SCAI_SECRET_KEY=

# Bootstrap accounts (created on first run only).
# Leave the password empty to have one generated into data/initial_credentials.txt
SCAI_BOOTSTRAP_ADMIN_USERNAME=admin
SCAI_BOOTSTRAP_ADMIN_PASSWORD=
SCAI_BOOTSTRAP_SUPERVISOR_PASSWORD=

# CORS: comma separated origins, or * for development
SCAI_ALLOWED_ORIGINS=*

# sqlite (default) or PostgreSQL, e.g.
# postgresql+psycopg://scai:secret@localhost:5432/scai
SCAI_DATABASE_URL=

# Detector: auto | ultralytics | onnx | hog | none
SCAI_DETECTOR_BACKEND=auto
# Local weights path or official model name (auto-downloaded by ultralytics)
SCAI_MODEL_PATH=yolo11n.pt
SCAI_MODEL_DEVICE=auto
SCAI_MODEL_IMGSZ=640
SCAI_MODEL_HALF=false
# Set to false on air-gapped hosts to avoid download attempts
SCAI_ALLOW_MODEL_AUTODOWNLOAD=true
SCAI_ONNX_MODEL_PATH=

# Tracking: iou (default, no extra deps) | bytetrack | botsort
SCAI_TRACKER_TYPE=iou
SCAI_TRACKER_MAX_AGE=45
SCAI_TRACKER_MIN_HITS=3
SCAI_TRACKER_IOU_THRESHOLD=0.3

# Detection / alerting defaults (per-camera overrides available in the UI)
SCAI_DETECT_CONF_DEFAULT=0.35
SCAI_PHONE_CONF_DEFAULT=0.30
SCAI_PHONE_USE_PERSISTENCE_DEFAULT=0.65
SCAI_PHONE_USE_WINDOW_SECONDS=4.0
SCAI_ALERT_COOLDOWN_DEFAULT=60
SCAI_MAX_VISIBLE_PEOPLE=50
SCAI_MAX_CAMERA_WORKERS=8
SCAI_FRAME_SAMPLE_DEFAULT=3

# Retention (also editable at runtime in the dashboard)
SCAI_EVENT_RETENTION_DAYS=90
SCAI_METRICS_RETENTION_DAYS=14
SCAI_TRACKING_ID_RESET_MINUTES=30

# Sandbox/demo simulated feed support
SCAI_ALLOW_SIMULATED_SOURCES=true

# Logging: INFO|DEBUG|WARNING ; JSON logs for containers
SCAI_LOG_LEVEL=INFO
SCAI_LOG_JSON=false

# Reverse proxy / rate limiting
SCAI_RATE_LIMIT_ENABLED=true
SCAI_TRUST_PROXY_HEADERS=false
